# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
# Anchored: unanchored, these also matched API pages such as v1/software/env/.
/build/
/dist/
/.venv/
/venv/
/env/

# Environment / secrets
.env
.env.*
!.env.example

# Databases (local dev)
*.db
*.sqlite
*.sqlite3

# Local static dump output (python -m app.dump --output dump)
/dump/

# Local-only handoff notes (private; never committed to the public repo)
*.local.md

# Local tooling/editor config (kept out of the public repo)
.claude/

# The static API is generated on every Pages deploy (.github/scripts/build-api.sh,
# then site/scripts/build-*.mjs). Only the hand-made games pointer is tracked.
/site/public/v1/*
!/site/public/v1/games/
/site/public/openapi.json

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
/htmlcov/
coverage.xml
.mypy_cache/
.ruff_cache/

# Editors / OS
.idea/
.vscode/
.DS_Store


# Generated by app.verify score runs; rebuilt on demand, too large to track (43 MB).
/data/_verify/state/scores.jsonl

# Page cache of the Wikipedia backfill tools (full third-party HTML); local only.
/data/_verify/cache/
